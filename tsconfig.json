{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@eui-components/ore-ui": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "playground/src",
    "playground/vite.config.ts"
  ]
}
